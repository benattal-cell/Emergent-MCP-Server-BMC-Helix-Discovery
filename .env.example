BMC_DISCOVERY_BASE_URL=https://example.bmc.com
BMC_DISCOVERY_API_VERSION=v1.18
BMC_DISCOVERY_TOKEN=replace_me
PORT=3000
# OAuth 2.1 auto-hébergé (plus de bearer statique) — voir « Authentification (OAuth 2.1) » dans le README
PUBLIC_BASE_URL=https://your-server.example.com
# OAUTH_REDIRECT_ALLOWLIST: préfixes supplémentaires (virgule), fusionnés avec les défauts ChatGPT/OpenAI/Claude/Mistral + localhost
# OAUTH_REDIRECT_ALLOWLIST=https://your-extra-callback.example.com/
# OAUTH_LOGIN_PASSWORD: si défini, /oauth/authorize affiche une page de consentement
# OAUTH_LOGIN_PASSWORD=change_me
# Visual output policy (text summary is always returned):
#   MCP_DEFAULT_VISUAL=true|false  -> emit PNG visuals (default true). Set false for text-only, token-efficient clients.
#   MCP_INCLUDE_SVG=true|false     -> also emit the raw SVG resource (default true). Set false to slim payloads for clients that only render PNG.
MCP_DEFAULT_VISUAL=true
MCP_INCLUDE_SVG=true
